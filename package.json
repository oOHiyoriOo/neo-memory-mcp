  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@modelcontextprotocol/sdk": "^1.8.0",
    "neo4j-driver": "^5.28.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2"
  },
  "allowScripts": {
    "esbuild": true,
    "onnxruntime-node": true,
    "protobufjs": true
  }
}
